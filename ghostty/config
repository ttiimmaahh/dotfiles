# Global Ghostty configuration

working-directory = home
quit-after-last-window-closed = true
mouse-hide-while-typing = true
window-decoration = true

# Window appearance
background-opacity = 0.80
background-opacity-cells = true
background-blur = true
background-blur-radius = 20
unfocused-split-opacity = 0.5

# Tokyo Night
# The explicit colors keep the palette stable if the bundled theme changes.
theme = tokyonight
background = #1a1b26
foreground = #c0caf5
selection-background = #33467c
selection-foreground = #c0caf5
cursor-color = #c0caf5
cursor-text = #15161e
palette = 0=#15161e
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#a9b1d6
palette = 8=#414868
palette = 9=#f7768e
palette = 10=#9ece6a
palette = 11=#e0af68
palette = 12=#7aa2f7
palette = 13=#bb9af7
palette = 14=#7dcfff
palette = 15=#c0caf5
font-family = "MesloLGS Nerd Font Mono"

# Keyboard shortcuts
keybind = ctrl+z=close_surface
keybind = ctrl+d=new_split:right
keybind = shift+enter=text:\n
# Optional CH57x macropad transport mappings
config-file = macropad-f13-adapter.conf
