#!/bin/sh

set -eu

usage() {
  cat <<'EOF'
Usage: ./apply [--dry-run] [--herdr-app-only]

Install this repository's dotfiles as symlinks. Existing destinations are
moved to ~/.dotfiles-backup/<timestamp-pid>/ before installation.

  --dry-run         show what would change without changing anything
  --herdr-app-only  install only the Herdr app files (herdr-app/) and the
                    agent skills (agents/skills/)

On Windows, use apply.ps1 (Herdr app files and agent skills only).
EOF
}

dry_run=false
herdr_app_only=false
for arg in "$@"; do
  case "$arg" in
    --dry-run) dry_run=true ;;
    --herdr-app-only) herdr_app_only=true ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
backup_dir="${HOME}/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)-$$"
backup_created=false
herdr_layout=ttiimmaahh

log() {
  printf '%s\n' "$*"
}

run() {
  if [ "$dry_run" = true ]; then
    printf '[dry-run]'
    printf ' %s' "$@"
    printf '\n'
  else
    "$@"
  fi
}

install_link() {
  source_path=$1
  destination=$2

  if [ -L "$destination" ] && [ "$(readlink "$destination")" = "$source_path" ]; then
    log "Already linked: $destination"
    # Herdr reloads a file only when the link in its folder changes, not the
    # target, so touch the link to pick up repo changes (after a pull, say).
    if [ "$dry_run" = false ]; then
      touch -h "$destination"
    fi
    return
  fi

  if [ -e "$destination" ] || [ -L "$destination" ]; then
    if [ "$backup_created" = false ]; then
      run mkdir -p "$backup_dir"
      backup_created=true
    fi
    backup_path="${backup_dir}${destination#"$HOME"}"
    run mkdir -p "$(dirname -- "$backup_path")"
    log "Backing up: $destination -> $backup_path"
    run mv "$destination" "$backup_path"
  fi

  run mkdir -p "$(dirname -- "$destination")"
  log "Linking: $destination -> $source_path"
  run ln -s "$source_path" "$destination"
}

# Herdr app: only personal files. The rest of the Herdr app folder is written
# by Herdr (shipped mods/layouts, type files, state), so link item by item.
install_herdr_app() {
  herdr_app=${HERDR_APP_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/herdr-app}

  case "$(uname -s)" in
    Darwin) platform=macos ;;
    Linux) platform=linux ;;
    *)
      log "Skipping Herdr app on $(uname -s): use apply.ps1 on Windows"
      return
      ;;
  esac

  # Default keymaps differ per platform (ctrl on Linux, cmd on macOS), so each
  # platform has its own keys/<platform>.json. On a platform without one yet,
  # adopt the keymap Herdr wrote there, pointing its palette key at ttiimmaahh-palette.
  keys="$repo_dir/herdr-app/keys/$platform.json"
  if [ ! -e "$keys" ]; then
    if [ -f "$herdr_app/keys.json" ] && [ ! -L "$herdr_app/keys.json" ]; then
      log "Adopting this machine's Herdr keymap as herdr-app/keys/$platform.json (commit it)"
      if [ "$dry_run" = true ]; then
        log "[dry-run] rebind app.palette to mod.open:ttiimmaahh-palette into $keys"
      else
        sed 's/"app\.palette"/"mod.open:ttiimmaahh-palette"/' "$herdr_app/keys.json" > "$keys"
      fi
    else
      log "Skipping Herdr keys: start Herdr once so it writes its $platform keymap, then run ./apply again"
    fi
  fi
  if [ -e "$keys" ] || [ "$dry_run" = true ]; then
    install_link "$keys" "$herdr_app/keys.json"
  fi

  install_link "$repo_dir/herdr-app/settings.json" "$herdr_app/settings.json"
  for dir in layouts themes; do
    for path in "$repo_dir/herdr-app/$dir"/*.json "$repo_dir/herdr-app/$dir"/*.svg; do
      if [ -e "$path" ]; then
        install_link "$path" "$herdr_app/$dir/$(basename -- "$path")"
      fi
    done
  done
  for path in "$repo_dir/herdr-app/mods"/*/; do
    if [ -d "$path" ]; then
      path=${path%/}
      install_link "$path" "$herdr_app/mods/$(basename -- "$path")"
    fi
  done

  # Links left behind by files renamed or removed in the repo.
  for link in "$herdr_app"/layouts/* "$herdr_app"/themes/* "$herdr_app"/mods/*; do
    if [ -L "$link" ] && [ ! -e "$link" ]; then
      case "$(readlink "$link")" in
        "$repo_dir/herdr-app/"*)
          log "Removing stale link: $link"
          run rm "$link"
          ;;
      esac
    fi
  done

  switch_herdr_layout
}

# Herdr remembers the shown layout per machine. Switch to the personal one
# only from Herdr's default (or this layout's old name), so a layout picked
# on purpose is left alone.
switch_herdr_layout() {
  if ! command -v herdr-app >/dev/null 2>&1; then
    return
  fi
  shown=$(herdr-app status 2>/dev/null | sed -n 's/^ *"layout": *"\([^"]*\)".*/\1/p')
  case "$shown" in
    "$herdr_layout") ;;
    "")
      log "Herdr isn't running: start it and run ./apply again to switch to the $herdr_layout layout"
      ;;
    main|my-main)
      log "Switching Herdr to the $herdr_layout layout"
      if [ "$dry_run" = true ]; then
        log "[dry-run] herdr-app do layout.switch --name $herdr_layout"
      else
        herdr-app do layout.switch --name "$herdr_layout" >/dev/null
      fi
      ;;
    *)
      log "Herdr shows the $shown layout; leaving it. To switch: herdr-app do layout.switch --name $herdr_layout"
      ;;
  esac
}

# Agent skills: ~/.agents/skills is read by Codex, pi and other agents;
# Claude Code reads ~/.claude/skills.
install_agent_skills() {
  for path in "$repo_dir/agents/skills"/*/; do
    if [ -d "$path" ]; then
      path=${path%/}
      name=$(basename -- "$path")
      install_link "$path" "$HOME/.agents/skills/$name"
      install_link "$path" "$HOME/.claude/skills/$name"
    fi
  done
}

if [ "$herdr_app_only" = false ]; then
  install_link "$repo_dir/ghostty" "$HOME/.config/ghostty"
  install_link "$repo_dir/nvim" "$HOME/.config/nvim"
  install_link "$repo_dir/herdr/config.toml" "$HOME/.config/herdr/config.toml"
  install_link "$repo_dir/zsh/.zshrc" "$HOME/.zshrc"
  install_link "$repo_dir/zsh/.zprofile" "$HOME/.zprofile"
  install_link "$repo_dir/zsh/.zshenv" "$HOME/.zshenv"
  install_link "$repo_dir/zsh/p10k.zsh" "$HOME/.config/zsh/p10k.zsh"
fi
install_herdr_app
install_agent_skills

if [ "$backup_created" = true ]; then
  log "Backup directory: $backup_dir"
fi
